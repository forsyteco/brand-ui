{
  "name": "@forsyteco/brand-ui",
  "version": "0.0.4",
  "description": "An implementation of Forsyte's   design system using React 🐝",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./visually-hidden": {
      "import": {
        "types": "./dist/visually-hidden/index.d.ts",
        "default": "./dist/visually-hidden/index.mjs"
      },
      "require": {
        "types": "./dist/visually-hidden/index.d.ts",
        "default": "./dist/visually-hidden/index.cjs"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme/index.mjs"
      },
      "require": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme/index.cjs"
      }
    },
    "./spinner": {
      "import": {
        "types": "./dist/spinner/index.d.ts",
        "default": "./dist/spinner/index.mjs"
      },
      "require": {
        "types": "./dist/spinner/index.d.ts",
        "default": "./dist/spinner/index.cjs"
      }
    },
    "./button": {
      "import": {
        "types": "./dist/button/index.d.ts",
        "default": "./dist/button/index.mjs"
      },
      "require": {
        "types": "./dist/button/index.d.ts",
        "default": "./dist/button/index.cjs"
      }
    },
    "./label": {
      "import": {
        "types": "./dist/label/index.d.ts",
        "default": "./dist/label/index.mjs"
      },
      "require": {
        "types": "./dist/label/index.d.ts",
        "default": "./dist/label/index.cjs"
      }
    },
    "./popover": {
      "import": {
        "types": "./dist/popover/index.d.ts",
        "default": "./dist/popover/index.mjs"
      },
      "require": {
        "types": "./dist/popover/index.d.ts",
        "default": "./dist/popover/index.cjs"
      }
    },
    "./input": {
      "import": {
        "types": "./dist/input/index.d.ts",
        "default": "./dist/input/index.mjs"
      },
      "require": {
        "types": "./dist/input/index.d.ts",
        "default": "./dist/input/index.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./components.css": "./dist/brand-ui.css",
    "./fonts/*": "./fonts/*",
    "./tailwind": "./tailwind.config.js"
  },
  "files": [
    "dist",
    "styles.css",
    "fonts",
    "tailwind.config.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forsyteco/brand-ui.git"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwind"
  ],
  "author": "etiCloud Ltd",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@github/relative-time-element": "^5.0.0",
    "@headlessui/react": "^2.2.9",
    "@lit-labs/react": "^2.1.3",
    "@tailwindcss/vite": "^4.1.17",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "lucide-react": "^0.556.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.1",
    "react-day-picker": "^9.12.0",
    "react-dom": "^19.2.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@storybook/addon-vitest": "^10.1.9",
    "@storybook/react-vite": "^10.1.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "jsdom": "^27.2.0",
    "playwright": "^1.57.0",
    "rollup": "^4.53.5",
    "storybook": "^10.1.9",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.6",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.0.15"
  },
  "scripts": {
    "build": "vite build",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run -c vitest.unit.config.ts",
    "test:cov": "vitest run -c vitest.unit.config.ts --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=19.2.1 <20",
    "react-dom": ">=19.2.1 <20",
    "tailwindcss": ">=4.1.17 <5"
  }
}
